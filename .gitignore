# Sensitive files — NEVER commit
.env
*.env
*.env.local
*.env.production
secrets.json

# Python cache
__pycache__/
*.pyc
*.pyo

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.vscode/
.idea/

# Node modules (if ever added)
node_modules/

# Temporary files
*.tmp
*.log
# .claude/: no se sube nada salvo las reglas por módulo (.claude/rules/). Lo demás (settings.local, worktrees, launch.json) sigue fuera.
.claude/*
!.claude/rules/
